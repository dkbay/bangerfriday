# YouTube API OAuth credentials
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token

# OAuth redirect URL used by YouTube app config
YOUTUBE_REDIRECT_URL=http://localhost:8080/auth/callback

# Comma-separated admin names
ADMIN_USERS=lbk,mby

# Admin password for making users admin
ADMIN_PASSWORD=changeme
